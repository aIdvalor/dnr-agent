# Live model (optional). Without these the app and evals use the scripted models.
# One of:
#   DNR_MODEL=gateway:<provider>/<model>   + AI_GATEWAY_API_KEY=...
#   DNR_MODEL=openai:<model>               + OPENAI_API_KEY=...
#   DNR_MODEL=anthropic:<model>            + ANTHROPIC_API_KEY=...
DNR_MODEL=
AI_GATEWAY_API_KEY=
# Prices for the spend cap (USD per million tokens) and the cap itself for the live eval suite.
DNR_PRICE_INPUT_PER_MTOK=
DNR_PRICE_OUTPUT_PER_MTOK=
DNR_SPEND_CAP_USD=2
