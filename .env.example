# Live model (optional). Without these the app and evals use the scripted models.
# One of:
#   DNR_MODEL=gateway:<provider>/<model>   + AI_GATEWAY_API_KEY=...
#   DNR_MODEL=openai:<model>               + OPENAI_API_KEY=...
#   DNR_MODEL=anthropic:<model>            + ANTHROPIC_API_KEY=...
#   DNR_MODEL=google:<model>               + GOOGLE_GENERATIVE_AI_API_KEY=...  (e.g. google:gemini-3.1-flash-lite)
DNR_MODEL=
AI_GATEWAY_API_KEY=
# Prices for the spend cap (USD per million tokens) and the cap itself for the live eval suite.
DNR_PRICE_INPUT_PER_MTOK=
DNR_PRICE_OUTPUT_PER_MTOK=
DNR_SPEND_CAP_USD=2
# Live pacing: minimum ms between model calls (free tiers have low RPM). The eval harness defaults to 6500 for google: models.
DNR_LIVE_MIN_INTERVAL_MS=
# The demo UI defaults to replaying recorded live responses (no key needed). Live runs from the UI are refused unless this is 1.
DNR_DEMO_ALLOW_LIVE=
# Recording to replay in the demo (default evals/recordings/google_gemini-3.1-flash-lite.jsonl).
DNR_REPLAY_FILE=
